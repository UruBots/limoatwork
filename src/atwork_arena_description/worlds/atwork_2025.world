    <!-- ======================== LiDAR Barriers ==================== -->
    <!-- Three solid sides (back + left + right) make tables visible
         to LiDAR at Nav2 costmap level. Front is visual-only so the
         arm can reach in. Barrier height 30cm, matching wall spec. -->

    <!-- WS01 barrier (10cm table) -->
    <model name="WS01_barrier"><static>true</static>
      <pose>-2.0 1.0 0.0 0 0 -0.50</pose>
      <link name="link">
        <collision name="back"><pose>-0.25 0.0 0.15 0 0 0</pose><geometry><box><size>0.02 0.80 0.30</size></box></geometry></collision>
        <collision name="left"><pose>0.0 0.40 0.15 0 0 0</pose><geometry><box><size>0.50 0.02 0.30</size></box></geometry></collision>
        <collision name="right"><pose>0.0 -0.40 0.15 0 0 0</pose><geometry><box><size>0.50 0.02 0.30</size></box></geometry></collision>
        <visual name="back_v"><pose>-0.25 0.0 0.15 0 0 0</pose><geometry><box><size>0.02 0.80 0.30</size></box></geometry>
          <material><ambient>1 0 0 0.6</ambient><diffuse>1 0 0 0.6</diffuse></material></visual>
        <visual name="left_v"><pose>0.0 0.40 0.15 0 0 0</pose><geometry><box><size>0.50 0.02 0.30</size></box></geometry>
          <material><ambient>1 0 0 0.6</ambient><diffuse>1 0 0 0.6</diffuse></material></visual>
        <visual name="right_v"><pose>0.0 -0.40 0.15 0 0 0</pose><geometry><box><size>0.50 0.02 0.30</size></box></geometry>
          <material><ambient>1 0 0 0.6</ambient><diffuse>1 0 0 0.6</diffuse></material></visual>
        <visual name="front_v"><pose>0.25 0.0 0.15 0 0 0</pose><geometry><box><size>0.02 0.80 0.30</size></box></geometry>
          <material><ambient>1 0.5 0 0.3</ambient><diffuse>1 0.5 0 0.3</diffuse></material></visual>
      </link></model>

