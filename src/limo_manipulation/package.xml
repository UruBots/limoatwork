<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>limo_manipulation</name>
  <version>0.1.0</version>
  <description>
    Manipulation stack for LIMO + OpenManipulator-X + MyCobot 280
    (RoboCup @Work).  Provides pick-and-place in both Gazebo simulation
    and real robot.  OpenManipulator-X uses ros2_control
    JointTrajectoryController.  MyCobot 280 supports both ros2_control
    and direct pymycobot serial control.
  </description>
  <maintainer email="team@urubots.com">UruBots</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>action_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <exec_depend>xacro</exec_depend>

  <!-- MyCobot 280 support -->
  <exec_depend>mycobot_description</exec_depend>
  <exec_depend>mycobot_communication</exec_depend>

  <!-- AprilTag detection -->
  <depend>apriltag_msgs</depend>
  <depend>apriltag_detector</depend>

  <!-- Camera / vision (only needed on real robot, installed via rosdep) -->
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
