<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>limo_manipulation</name>
  <version>0.1.0</version>
  <description>
    Manipulation stack for LIMO + OpenManipulator-X (RoboCup @Work).
    Provides pick-and-place in both Gazebo simulation and real robot.
    Uses direct JointTrajectoryController for arm control and a pluggable
    object detector (mock in sim, RealSense-based on real robot).
  </description>
  <maintainer email="team@urubots.com">UruBots</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>action_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>open_manipulator_moveit_config</depend>

  <!-- AprilTag detection -->
  <depend>apriltag_msgs</depend>
  <depend>apriltag_detector</depend>

  <!-- Camera / vision (only needed on real robot, installed via rosdep) -->
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
