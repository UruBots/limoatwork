<?xml version="1.0" ?>
<!--
  ATTC (AprilTag Target Cube) — RoboCup @Work
  42 × 42 × 42 mm white cube with AprilTag 36h11 ID=0 on the top face.
  The tag face allows the manipulation stack to identify the cube and
  compute its 3D pose relative to the robot camera.
-->
<sdf version="1.6">
  <model name="attc_cube">
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.47e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.47e-05</iyy>
          <iyz>0</iyz>
          <izz>1.47e-05</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.042 0.042 0.042</size>
          </box>
        </geometry>
      </collision>

      <!-- Main cube body: white -->
      <visual name="body">
        <geometry>
          <box>
            <size>0.042 0.042 0.042</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!--
        AprilTag 36h11 ID=0 on the top face.
        The tag plane is placed slightly above the cube top (0.0211 m = half-height)
        to avoid z-fighting, and sized to cover the top face (40 mm).
        For Gazebo Fortress/Harmonic with Ogre rendering, we reference a PNG texture
        located in the atwork_arena_description materials/textures directory.
      -->
      <visual name="apriltag_top">
        <pose>0 0 0.0211 0 0 0</pose>
        <geometry>
          <box>
            <size>0.040 0.040 0.0001</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://atwork_arena_description/materials/textures/apriltag_36h11_id0.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- AprilTag on the front face (Y+) — useful when cube is upright -->
      <visual name="apriltag_front">
        <pose>0 0.0211 0 1.5708 0 0</pose>
        <geometry>
          <box>
            <size>0.040 0.040 0.0001</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://atwork_arena_description/materials/textures/apriltag_36h11_id0.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
