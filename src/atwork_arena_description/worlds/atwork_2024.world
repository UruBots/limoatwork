<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="atwork_2024_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <!-- A global light source -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <!-- Arena Walls (Extended layout to match pose_dict) -->
    <model name="arena_walls">
      <static>true</static>
      <link name="link">
        <collision name="wall1">
          <pose>3 4.5 0.1 0 0 0</pose>
          <geometry><box><size>10 0.05 0.2</size></box></geometry>
        </collision>
        <visual name="wall1_v">
          <pose>3 4.5 0.1 0 0 0</pose>
          <geometry><box><size>10 0.05 0.2</size></box></geometry>
        </visual>
        <collision name="wall2">
          <pose>3 -4.5 0.1 0 0 0</pose>
          <geometry><box><size>10 0.05 0.2</size></box></geometry>
        </collision>
        <visual name="wall2_v">
          <pose>3 -4.5 0.1 0 0 0</pose>
          <geometry><box><size>10 0.05 0.2</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- START Area (Green Tape) -->
    <model name="start_area">
      <static>true</static>
      <pose>0 -1 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Workstations from mission_ws.py -->
    <include>
      <name>WS01</name>
      <uri>model://table_10cm</uri>
      <pose>2.15 -0.35 0.05 0 0 -0.66</pose>
    </include>
    <include>
      <name>WS02</name>
      <uri>model://table_10cm</uri>
      <pose>1.85 1.20 0.05 0 0 0.30</pose>
    </include>

    <!-- LiDAR-visible barrier walls around WS01 and WS02.
         The LIMO LiDAR beam sits above the 10 cm tables so it cannot detect
         them directly.  These thin walls (height 0.20 m) sit at the table
         perimeter at LiDAR height so Nav2 costmaps see them as obstacles and
         will not plan paths through the tables.
         WS01 table: center (2.15,-0.35), size 0.5×0.8, yaw=-0.66 rad
         Wall panels placed along the four table edges. -->
    <!-- Barrier walls around each workstation table.
         Purpose: the LIMO LiDAR (height ~0.15 m) cannot see 10 cm tall tables,
         so Nav2 would plan paths through them.  Three solid walls (back + sides)
         make the table area a LiDAR-visible obstacle.  The FRONT face is
         visual-only (no collision) so the robot arm can reach in from the
         approach side without hitting a barrier.

         WS01 table: center (2.15,-0.35), size 0.5×0.8 m, yaw=-0.66 rad
         Robot approaches from local +x direction (table "front"). -->
    <model name="WS01_barrier">
      <static>true</static>
      <pose>2.15 -0.35 0.0 0 0 -0.66</pose>
      <link name="link">
        <!-- back  (local -x) — solid, LiDAR sees it -->
        <collision name="back"><pose>-0.25  0.0 0.15 0 0 0</pose>
          <geometry><box><size>0.02 0.80 0.30</size></box></geometry></collision>
        <!-- left  (local +y) — solid -->
        <collision name="left"><pose> 0.0  0.40 0.15 0 0 0</pose>
          <geometry><box><size>0.50 0.02 0.30</size></box></geometry></collision>
        <!-- right (local -y) — solid -->
        <collision name="right"><pose> 0.0 -0.40 0.15 0 0 0</pose>
          <geometry><box><size>0.50 0.02 0.30</size></box></geometry></collision>
        <!-- front (local +x) — visual only, arm passes through freely -->
        <visual name="front_v"><pose> 0.25  0.0 0.15 0 0 0</pose>
          <geometry><box><size>0.02 0.80 0.30</size></box></geometry>
          <material><ambient>1 0.5 0 0.5</ambient><diffuse>1 0.5 0 0.5</diffuse></material></visual>
        <visual name="back_v"><pose>-0.25  0.0 0.15 0 0 0</pose>
          <geometry><box><size>0.02 0.80 0.30</size></box></geometry>
          <material><ambient>1 0 0 0.6</ambient><diffuse>1 0 0 0.6</diffuse></material></visual>
        <visual name="left_v"><pose> 0.0  0.40 0.15 0 0 0</pose>
          <geometry><box><size>0.50 0.02 0.30</size></box></geometry>
          <material><ambient>1 0 0 0.6</ambient><diffuse>1 0 0 0.6</diffuse></material></visual>
        <visual name="right_v"><pose> 0.0 -0.40 0.15 0 0 0</pose>
          <geometry><box><size>0.50 0.02 0.30</size></box></geometry>
          <material><ambient>1 0 0 0.6</ambient><diffuse>1 0 0 0.6</diffuse></material></visual>
      </link>
    </model>

    <!-- WS02 table: center (1.85,1.20), size 0.5×0.8 m, yaw=0.30 rad -->
    <model name="WS02_barrier">
      <static>true</static>
      <pose>1.85 1.20 0.0 0 0 0.30</pose>
      <link name="link">
        <collision name="back"><pose>-0.25  0.0 0.15 0 0 0</pose>
          <geometry><box><size>0.02 0.80 0.30</size></box></geometry></collision>
        <collision name="left"><pose> 0.0  0.40 0.15 0 0 0</pose>
          <geometry><box><size>0.50 0.02 0.30</size></box></geometry></collision>
        <collision name="right"><pose> 0.0 -0.40 0.15 0 0 0</pose>
          <geometry><box><size>0.50 0.02 0.30</size></box></geometry></collision>
        <visual name="front_v"><pose> 0.25  0.0 0.15 0 0 0</pose>
          <geometry><box><size>0.02 0.80 0.30</size></box></geometry>
          <material><ambient>0 0.5 1 0.5</ambient><diffuse>0 0.5 1 0.5</diffuse></material></visual>
        <visual name="back_v"><pose>-0.25  0.0 0.15 0 0 0</pose>
          <geometry><box><size>0.02 0.80 0.30</size></box></geometry>
          <material><ambient>0 0 1 0.6</ambient><diffuse>0 0 1 0.6</diffuse></material></visual>
        <visual name="left_v"><pose> 0.0  0.40 0.15 0 0 0</pose>
          <geometry><box><size>0.50 0.02 0.30</size></box></geometry>
          <material><ambient>0 0 1 0.6</ambient><diffuse>0 0 1 0.6</diffuse></material></visual>
        <visual name="right_v"><pose> 0.0 -0.40 0.15 0 0 0</pose>
          <geometry><box><size>0.50 0.02 0.30</size></box></geometry>
          <material><ambient>0 0 1 0.6</ambient><diffuse>0 0 1 0.6</diffuse></material></visual>
      </link>
    </model>

    <!-- Objects on WS01 -->
    <include>
      <name>obj_f20_1</name>
      <uri>model://f20_20</uri>
      <pose>2.15 -0.35 0.15 0 0 0</pose>
    </include>
    <include>
      <name>obj_m20_1</name>
      <uri>model://nut_m20</uri>
      <pose>2.1 -0.3 0.15 0 0 0</pose>
    </include>

    <!-- Objects on WS02 -->
    <include>
      <name>obj_s40_1</name>
      <uri>model://s40_40</uri>
      <pose>1.85 1.20 0.15 0 0 0</pose>
    </include>

    <!-- ATTC Cube on WS02 -->
    <include>
      <name>attc_1</name>
      <uri>model://attc_cube</uri>
      <pose>1.9 1.25 0.15 0 0 0</pose>
    </include>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>4.0 1.0 10.0 0 1.57 -1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
