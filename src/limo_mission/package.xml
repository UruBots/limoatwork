<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>limo_mission</name>
  <version>0.0.0</version>
  <description>Mission orchestration + docking for LIMO (Nav2 + LiDAR)</description>

  <maintainer email="igordacosta.sl010@gmail.com">solverbot</maintainer>
  <license>Apache-2.0</license>

  <!-- Python runtime -->
  <depend>rclpy</depend>

  <!-- Messages used -->
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- Nav2 actions we call: NavigateToPose, BackUp -->
  <depend>nav2_msgs</depend>

  <!-- If you already use it elsewhere, keep it -->

  <!-- Action / interface generation -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Needed for building / using generated interfaces -->
  <depend>rosidl_default_runtime</depend>

  <!-- Optional but common -->
  <depend>action_msgs</depend>
  <depend>limo_mission_msgs</depend>


  <!-- This marks that this package provides interfaces -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Tests -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
