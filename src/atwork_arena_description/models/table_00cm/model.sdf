        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.8 0.01</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.8 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
