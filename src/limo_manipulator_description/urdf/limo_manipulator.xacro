<?xml version="1.0"?>
<robot name="limo_manipulator" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ================================================================
       arm_type: "open_manipulator" | "mycobot" | "none"
       Selects which manipulator arm to mount on the LIMO chassis.
       ================================================================ -->
  <xacro:arg name="arm_type" default="open_manipulator"/>
  <xacro:property name="arm_type" value="$(arg arm_type)"/>

  <!-- ======================== LIMO Base ============================ -->
  <xacro:include filename="$(find limo_description)/urdf/limo_four_diff.xacro" />

  <!-- ======================== OpenManipulator-X ==================== -->
  <xacro:if value="${arm_type == 'open_manipulator'}">
    <xacro:include filename="$(find open_manipulator_x_description)/urdf/open_manipulator_x_arm.urdf.xacro" />
    <xacro:include filename="$(find open_manipulator_x_description)/gazebo/open_manipulator_x.gazebo.xacro" />
    <xacro:include filename="$(find limo_manipulator_description)/urdf/manipulator_control.ros2_control.xacro" />

    <joint name="manipulator_mounting_joint" type="fixed">
      <parent link="base_link" />
      <child link="link1" />
      <origin xyz="0.04 0.0 0.05" rpy="0 0 0" />
    </joint>

    <xacro:open_manipulator_x prefix="" />
    <xacro:open_manipulator_x_gazebo prefix="" />
    <xacro:limo_manipulator_control prefix="" />
  </xacro:if>

  <!-- ======================== MyCobot 280 ========================== -->
  <xacro:if value="${arm_type == 'mycobot'}">
    <xacro:include filename="$(find mycobot_description)/urdf/mycobot_280_arduino/mycobot_280_arduino.urdf" />
    <xacro:include filename="$(find limo_manipulator_description)/urdf/mycobot_control.ros2_control.xacro" />

    <joint name="manipulator_mounting_joint" type="fixed">
      <parent link="base_link" />
      <child link="g_base" />
      <!-- x=0: centred on chassis, z=0.10: on top of LIMO deck (chassis top ~0.05 + base clearance) -->
      <origin xyz="0.0 0.0 0.10" rpy="0 0 0" />
    </joint>

    <xacro:limo_mycobot_control prefix="" />
  </xacro:if>

  <!-- ======================== Gazebo Sim Plugins =================== -->
  <gazebo>
    <!-- ros2_control plugin (only when an arm is mounted) -->
    <xacro:if value="${arm_type == 'open_manipulator'}">
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find limo_manipulator_bringup)/config/controllers.yaml</parameters>
      </plugin>
    </xacro:if>
    <xacro:if value="${arm_type == 'mycobot'}">
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find limo_manipulator_bringup)/config/controllers_mycobot.yaml</parameters>
      </plugin>
    </xacro:if>

    <!-- Joint State Publisher (arm joints visible to Gazebo) -->
    <xacro:if value="${arm_type != 'none'}">
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
      </plugin>
    </xacro:if>

    <!-- LIMO DiffDrive (always active, cmd_vel only, no odom) -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel</left_joint>
      <left_joint>rear_left_wheel</left_joint>
      <right_joint>front_right_wheel</right_joint>
      <right_joint>rear_right_wheel</right_joint>
      <wheel_separation>0.175</wheel_separation>
      <wheel_radius>0.045</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <odom_publish_frequency>0</odom_publish_frequency>
      <topic>/cmd_vel</topic>
    </plugin>

    <!-- Ground-truth odometry from model pose (avoids skid-steer drift) -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

  <!-- ======================== LiDAR Sensor ========================= -->
  <gazebo reference="laser_link">
    <sensor name="laser_sensor" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>laser_link</gz_frame_id>
      <frame_id>laser_link</frame_id>
      <update_rate>8</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-2.094395</min_angle>
            <max_angle>2.094395</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ======================== IMU Sensor =========================== -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <frame_id>imu_link</frame_id>
    </sensor>
  </gazebo>

  <!-- ======================== RGB Camera =========================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.072"/>
      <inertia ixx="3e-5" ixy="0" ixz="0" iyy="3e-5" iyz="0" izz="3e-5"/>
    </inertial>
  </link>

  <link name="camera_color_optical_frame"/>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0.0 0.52" rpy="0.0 0.873 0.0"/>
  </joint>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <topic>camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>3.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <always_on>1</always_on>
      <update_rate>5</update_rate>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>
